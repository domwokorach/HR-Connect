# Base URL of the Express API (no trailing slash, no /api).
# Leave empty to auto-detect: Expo Web → same host, port 4000; Expo Go → your computer's LAN IP from Metro, port 4000.
# Set it explicitly if auto-detection is wrong, e.g. EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=

# Dev-only: show the demo account panel on the sign-in screen (ignored in production bundles)
EXPO_PUBLIC_DEMO_LOGIN=false
