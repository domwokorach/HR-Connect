{
  "compilerOptions": {
    "target": "ES2022", "module": "node16", "moduleResolution": "node16", "lib": ["ES2022"],
    "outDir": "dist", "rootDir": ".", "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "noUncheckedIndexedAccess": false, "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "prisma/seed.ts", "tests"]
}
