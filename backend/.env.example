# PostgreSQL connection (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hrconnect?schema=public

# JWT — generate two DIFFERENT secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-different-strong-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

PORT=4000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API (Expo Web dev server etc.). Native apps are not subject to CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Development only: print password-reset links to the server console (there is no mail server in dev)
# In production wire src/services/mailer.ts to your email provider.
APP_URL=http://localhost:8081

# Used only by `npm run db:seed`. If unset a random password is generated and printed once.
SEED_PASSWORD=

# Cybersource / Visa Acceptance (server-side only; set as Secret in Vercel, never in Expo public vars).
# All optional: with no credentials the payments routes report "not_configured".
CYBERSOURCE_ENV=sandbox
CYBERSOURCE_ORG_ID=
CYBERSOURCE_KEY_ID=
CYBERSOURCE_SHARED_SECRET=
CYBERSOURCE_WEBHOOK_SIGNATURE_KEY=
# Vercel Cron bearer secret for /api/payments/cron/reconcile
CRON_SECRET=
